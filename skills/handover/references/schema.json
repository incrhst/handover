{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://incrhst.github.io/handover/schema/v1.json",
  "title": "Handover file, format version 1",
  "description": "A role handover: a first-month path, recurring duties, answers to common questions and reference material. Files use the .handover extension and contain UTF-8 JSON. Spec: https://github.com/incrhst/handover/blob/main/spec/SPEC.md",
  "type": "object",
  "required": ["handover", "id", "title"],
  "additionalProperties": false,
  "patternProperties": { "^x-": true },
  "properties": {
    "$schema": { "type": "string", "description": "Optional. URL of this schema, for editors and validators." },
    "handover": { "type": "string", "pattern": "^1\\.[0-9]+$", "description": "Format version. Files written to this schema use \"1.0\"." },
    "id": { "$ref": "#/$defs/id", "description": "Stable identifier for this handover. Keep it the same across versions so progress carries over." },
    "title": { "$ref": "#/$defs/line" },
    "summary": { "$ref": "#/$defs/markdown", "description": "Introduction shown at the top." },
    "from": {
      "type": "object",
      "description": "The person handing over.",
      "required": ["name"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "role": { "$ref": "#/$defs/line" },
        "contact": { "$ref": "#/$defs/line", "description": "How to reach them. Never a password." },
        "availableUntil": { "$ref": "#/$defs/date", "description": "Last day they can answer questions." }
      }
    },
    "updated": { "$ref": "#/$defs/date", "description": "When the content was last changed." },
    "timezone": { "type": "string", "description": "IANA time zone used to work out which day it is, e.g. \"Europe/London\". Defaults to the reader's own time zone." },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "dailyExportTime": { "$ref": "#/$defs/time", "description": "When a tool should write the day's task sheet. Default 07:00." }
      }
    },
    "path": {
      "type": "array",
      "description": "Stages of the first weeks, in order. One is shown at a time.",
      "items": { "$ref": "#/$defs/stage" }
    },
    "recurring": {
      "type": "array",
      "description": "Duties that repeat on a schedule.",
      "items": { "$ref": "#/$defs/recurring" }
    },
    "questions": {
      "type": "array",
      "description": "Common questions with short answers.",
      "items": { "$ref": "#/$defs/question" }
    },
    "sections": {
      "type": "array",
      "description": "Reference material, one topic per section.",
      "items": { "$ref": "#/$defs/section" }
    },
    "progress": { "$ref": "#/$defs/progress" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "line": { "type": "string", "minLength": 1 },
    "markdown": { "type": "string", "minLength": 1, "description": "Text in the handover Markdown subset. Start with \"TODO:\" or use {TODO: ...} to mark information still to be filled in." },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "datetime": { "type": "string", "description": "ISO 8601 date and time." },
    "time": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
    "weekday": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] },
    "stage": {
      "type": "object",
      "required": ["id", "title", "tasks"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/line" },
        "summary": { "$ref": "#/$defs/markdown" },
        "tip": {
          "type": "object",
          "required": ["text"],
          "additionalProperties": false,
          "patternProperties": { "^x-": true },
          "properties": { "title": { "$ref": "#/$defs/line" }, "text": { "$ref": "#/$defs/markdown" } }
        },
        "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/task" } }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "text"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/markdown" },
        "detail": { "$ref": "#/$defs/markdown" }
      }
    },
    "recurring": {
      "type": "object",
      "required": ["id", "text", "every"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/markdown" },
        "every": { "type": "string", "enum": ["day", "weekday", "week", "month", "quarter", "year"] },
        "on": {
          "description": "For every: week. Day or days of the week. Default mon.",
          "oneOf": [
            { "$ref": "#/$defs/weekday" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weekday" } }
          ]
        },
        "day": {
          "description": "For every: month or quarter. Day of the month, or \"last\". Days past the end of a short month fall on its last day. Default 1.",
          "oneOf": [ { "type": "integer", "minimum": 1, "maximum": 31 }, { "const": "last" } ]
        },
        "monthOfQuarter": { "type": "integer", "minimum": 1, "maximum": 3, "description": "For every: quarter. 1 = Jan/Apr/Jul/Oct. Default 1." },
        "date": { "type": "string", "pattern": "^\\d{2}-\\d{2}$", "description": "For every: year. Month and day, MM-DD." },
        "time": { "$ref": "#/$defs/time" },
        "start": { "$ref": "#/$defs/date" },
        "end": { "$ref": "#/$defs/date" },
        "detail": { "$ref": "#/$defs/markdown" },
        "see": { "$ref": "#/$defs/id", "description": "id of a section with more detail." }
      }
    },
    "question": {
      "type": "object",
      "required": ["q", "a"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "q": { "$ref": "#/$defs/line" },
        "a": { "$ref": "#/$defs/markdown" },
        "tag": { "$ref": "#/$defs/line" },
        "see": { "$ref": "#/$defs/id", "description": "id of a section with more detail." }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "body"],
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/line" },
        "body": { "$ref": "#/$defs/markdown" }
      }
    },
    "progress": {
      "type": "object",
      "description": "Optional. One reader's progress, included when a file is exported with progress.",
      "additionalProperties": false,
      "patternProperties": { "^x-": true },
      "properties": {
        "updated": { "$ref": "#/$defs/datetime" },
        "firstSeen": { "$ref": "#/$defs/date", "description": "First day the reader opened this handover. Recurring duties before it are never overdue." },
        "tasks": {
          "type": "object",
          "description": "Completed path tasks: task id → when it was done.",
          "additionalProperties": { "$ref": "#/$defs/datetime" }
        },
        "recurring": {
          "type": "object",
          "description": "Completed occurrences: \"<recurring id>@<YYYY-MM-DD>\" → when it was done.",
          "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]{0,63}@\\d{4}-\\d{2}-\\d{2}$" },
          "additionalProperties": { "$ref": "#/$defs/datetime" }
        },
        "notes": { "type": "string", "description": "The reader's own notes and questions." }
      }
    }
  }
}
