      "detail": "Finance pays claims submitted by Thursday noon in the same week. Miss it and Dana's card statement goes unpaid for a week."
    },
    { "id": "diary-review", "text": "Review next week's diary with Dana", "area": "Diary and correspondence", "every": "week", "on": "fri", "time": "15:00" },
