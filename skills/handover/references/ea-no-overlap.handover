  "asks": [
    {
      "id": "breaks",
      "minutes": 15,
      "draft": "Here is the risk list I drafted from the last year of work. Tell me what is missing, and which three items would hurt most if they failed.",
      "replyBy": "2026-09-04",
      "default": "The risk list stands as drafted, ranked by Priya.",
