  "path": [
    {
      "id": "days-1-2",
      "title": "Days 1–2 · Get in",
      "summary": "Access and the one-page brief. Read nothing else on day one.",
      "tip": { "title": "No overlap", "text": "Priya has already left, so Dana held the desk last week. Start by walking the open items with her." },
      "tasks": [
        { "id": "brief", "text": "**Read the one-page brief** in the documents list, and nothing else today." },
        {
          "id": "walk-open-items",
          "text": "**Walk the open items with Dana**: what moved while she held the desk, and what is due. Update each one in [Open items](#handover-open)."
        },
        {
          "id": "access-check",
          "text": "**Run the access check** on every system in [Systems and documents](#handover-access). Each failure goes on the gaps list today."
        }
      ]
    },
    {
      "id": "week-1",
      "title": "Week 1 · Learn the rhythm",
      "summary": "Two new things a day at most.",
      "tasks": [
        { "id": "meet-stakeholders", "text": "**Meet Ravi, Joy and Andre** from [People](#handover-people)." },
        { "id": "first-expenses", "text": "**Submit Thursday's expense claims** using the step guide." },
        { "id": "read-decisions", "text": "**Read the decisions and rules** in [Rules, decisions and risks](#handover-knowledge)." }
      ]
    },
    {
      "id": "week-2",
      "title": "Week 2 · Run it",
      "summary": "Ask Dana for five minutes a day: what did you notice?",
      "tasks": [
        { "id": "run-diary-review", "text": "**Run the Friday diary review** with Dana." },
        { "id": "close-gaps", "text": "**Close gaps**: fix the document, log the answer, or hand it to Dana." },
        { "id": "cover-plan", "text": "**Agree diary cover** for your leave {TODO: who covers the diary when Marcus is away}." }
      ]
    },
    {
      "id": "yours",
      "title": "Weeks 3–4 · It's yours",
      "tasks": [
        { "id": "board-pack-dry-run", "text": "**Prepare a dry run of the December board pack** with Joy, using the recording." },
        { "id": "final-check", "text": "**Run the final check with Dana** and record her verdict." }
      ]
    }
  ],
  "recurring": [
    { "id": "inbox", "text": "Triage Dana's inbox and flag anything for today", "area": "Diary and correspondence", "every": "weekday", "time": "08:00" },
